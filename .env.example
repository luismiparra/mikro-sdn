# Copy to .env and edit:   cp .env.example .env
# Every variable is documented in docs/configuration/environment.md

#----------------------------------------------------------------- paths
# Folder with inventory/, firewall/, general/, dhcp/ and clean_routes.yml
CONFIG="config"
# Folder with control.yml (run on/off, mode, dry run)
CONTROLPATH="control"
# Private folder: generated keys, proposed config, VPN client files. Never commit it.
SECRETS="secrets"
# Output folder for the generated HTML/Markdown docs and BIND zone snippets
WEB="web"
# Inventory folder read by the monitoring tool
INVENTORY="config/inventory"
# Script the web portal launches on /router_boot_update
MAIN_AUTO_PY_EXEC="1-mikro-auto/mikro_main.py"

#----------------------------------------------------------------- behaviour
# Any non-empty value enables debug logs (and makes errors wait for Enter). Leave empty in CI.
DEBUGMODE=
# Comment prefixes the automation never deletes from a router. The FIRST one is also used as the
# prefix of the management VPN objects. Prefix the comment of anything you created by hand and
# want to keep (WAN address, default route, your own firewall rules...).
LOCALSTRING='["local_auto_", "auto_webapp_"]'
# Name shown in generated docs, WireGuard/FRR file headers and the web portal
ORG_NAME="mikro-sdn"

#----------------------------------------------------------------- router credentials
# API user with full rights (automation, web portal)
MIKRO_USER="USER_MIKRO_WRITE"
MIKRO_PASSWORD="PASSWORD_MIKRO_WRITE"
# Read only user (monitoring, NetBox serial numbers)
MIKRO_READ_USER="USER_MIKRO_READ"
MIKRO_READ_PASSWORD="PASSWORD_MIKRO_READ"

#----------------------------------------------------------------- optional router features
# Shared secret of the RADIUS servers (configlet wifi)
RADIUS_SECRET=
# Certificate already imported on the router for the user-manager (configlet radius_server).
# Empty: radius.<device domain>.crt
RADIUS_CERTIFICATE=
# MQTT broker for the netwatch RTT metrics (devices with mqtt_netwatch_monitor: true)
MQTT_SERVER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
# URL routers call 5 min after boot to ask for a config push (web portal /router_boot_update).
# Empty: the boot script is not created
BOOT_UPDATE_URL=
# JSON list of hosts routers ping every hour; when NONE answers the router REBOOTS.
# Empty: the watchdog is not created. Only set it with hosts that are always reachable.
MGMT_CHECK_HOSTS=
# JSON list of management hosts allowed by the onboarding script of new routers
MGMT_HOSTS='[]'

#----------------------------------------------------------------- monitoring (2-mikro-monitoring)
INFLUX_URL="http://localhost:8086"
INFLUX_API_KEY=
INFLUX_ORG=
INFLUX_BUCKET=

#----------------------------------------------------------------- web portal (3-mikro-webportal)
PORTAL_HOME_URL=

#----------------------------------------------------------------- NetBox (4-netbox)
NETBOX_URL="http://netbox.example.int:8000"
NETBOX_TOKEN=
# Tag that marks the objects owned by the automation (only those are updated or deleted)
NETBOX_TAG="MSDN-LAB"
# 1 = only log what would change
NETBOX_DRYRUN=1

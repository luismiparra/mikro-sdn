#MANUAL STEPS:
#1) Reset password and create admin
#2) Create api user
#3) Create read only user (monitoring)
#4) Upload files:
#----last software version
#----user-manager package (only for the radius_server configlet)
#----{{domain}}.crt
#----{{domain}}.key
#----radius.{{domain}}.crt
#----radius.{{domain}}.key
#----{{org_name}}_CA.crt
#-------------------------------------------------------------------

#SCRIPT CLI STEPS:

system/reboot

certificate/import file-name={{org_name}}_CA.crt name={{org_name}}_CA.crt passphrase=""
certificate/import file-name=radius.{{domain}}.crt name=radius.{{domain}}.crt passphrase=""
certificate/import file-name=radius.{{domain}}.key name=radius.{{domain}}.key passphrase=""
certificate/import file-name={{domain}}.crt name={{domain}}.crt passphrase=""
certificate/import file-name={{domain}}.key name={{domain}}.key passphrase=""

/ip/firewall/address-list
{% for host in mgmt_hosts -%}
add address={{host}} comment={{localstring}}ACL4_ONBOARD_MGMT list={{localstring}}ACL4_ONBOARD_MGMT
{% endfor -%}
/ip/firewall/filter
add action=accept chain=input comment={{localstring}}INPUT_ALLOW_VPN_MGMT src-address-list={{localstring}}ACL4_ONBOARD_MGMT

/interface wireguard
add comment={{wg_comment}} mtu=1420 name={{wg_name}} private-key="{{wg_private_key}}"

/interface wireguard peers
add allowed-address={{peer_allowed_address}} comment={{peer_comment}} endpoint-address={{endpoint_address}} \
endpoint-port={{peer_endpoint_port}} interface={{peer_interface}} persistent-keepalive={{peer_persistent_keepalive}} \
preshared-key="{{peer_preshared_key}}" public-key="{{peer_public_key}}"

/ip address
add address={{ip_address}} comment={{ip_comment}} interface={{wg_name}}


/system scheduler
add comment={{portchange_comment}} interval=30m name={{portchange_comment}} on-event="/interface wireguard set {{wg_name}} listen-port=0" policy=read,write,policy,test,password,sniff,sensitive,romon start-date=2022-01-01 start-time=00:00:00